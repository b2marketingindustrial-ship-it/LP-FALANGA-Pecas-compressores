---
/**
 * Painel de apoio à identificação — fase "apoio" da biblioteca B2.
 *
 * Painel navy dentro de uma seção clara: é uma das duas seções que carregam bloco
 * navy (`carriesNavy`), o respiro escuro da primeira metade da página.
 *
 * VARIANTE LOCAL desta LP (mockup do cliente, 21/10/2026, docs/BRIEFING.md): a mesma
 * linguagem do painel "Como funciona" da LP de compressores de parafuso — painel mais
 * largo que o container, fim do título em amarelo, os 6 dados em cards contornados com
 * ícone amarelo, e uma faixa final com o selo da equipe e o CTA. O contrato da seção é
 * o mesmo da biblioteca — 6 dados, CTA `identificar-cta`, painel navy, `tone`/`rhythm`.
 *
 * ATENÇÃO: `npm run compose` recopia o componente da biblioteca e desfaz esta variante.
 * Recompor a página exige reaplicá-la a partir do git.
 */
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { supportPanel } from '@data/sections/identificar'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const items = supportPanel.items

// O trecho em amarelo é o fim do título; o texto inteiro continua em `supportPanel.title`.
const cut = supportPanel.title.lastIndexOf(supportPanel.highlight)
const lead = cut >= 0 ? supportPanel.title.slice(0, cut).trimEnd() : supportPanel.title
const highlight = cut >= 0 ? supportPanel.highlight : ''
---

<Section id="identificar" tone={tone} rhythm={rhythm} container={false}>
  {/* Painel mais largo que o container da página, como no mockup: mais baixo e mais comprido. */}
  <div class="mx-auto w-full max-w-[1680px] px-6 lg:px-8">
    <div class="support-panel relative overflow-hidden rounded-[28px] p-6 shadow-[0_24px_60px_-34px_rgba(0,24,48,0.8)] sm:p-8 lg:px-10 lg:py-9 2xl:px-14 2xl:py-10">
      <div class="relative">
        {/* Cabeçalho */}
        <p class="flex items-center gap-4 font-sans text-[13px] font-semibold tracking-[0.2em] text-[#8bcdff] uppercase sm:text-[14px]">
          <span
            aria-hidden="true"
            class="h-[4px] w-10 shrink-0 rounded-full bg-brand-yellow"
          ></span>
          {supportPanel.eyebrow}
        </p>
        <h2 class="mt-3 font-display text-[2.25rem] leading-[1.05] font-extrabold tracking-[-0.03em] text-neutral-light sm:text-[2.75rem] lg:text-[3rem] xl:text-[3.3rem] 2xl:text-[3.6rem]">
          {/* `block` em toda largura, e não `sm:block`: o trecho amarelo daqui é curto
              ("a peça certa?") e, inline no mobile, deixava o "a" pendurado no fim da linha. */}
          {lead} {highlight && <span class="block text-brand-yellow">{highlight}</span>}
        </h2>
        <p class="mt-3 max-w-5xl font-sans text-lg leading-relaxed text-neutral-light/80">
          {supportPanel.text}
        </p>

        {/* Os 6 dados, em cards contornados */}
        <ul
          class="mt-8 grid gap-x-4 gap-y-4 sm:grid-cols-2 lg:grid-cols-6 2xl:gap-x-5"
          aria-label="Dados que ajudam a identificar a peça"
        >
          {items.map((item) => (
            <li class="support-card flex h-full flex-col rounded-2xl border border-[#1f5fa8]/80 bg-white/[0.03] px-5 py-5 2xl:px-6">
              <Icon name={item.icon} class="size-10 shrink-0 text-brand-yellow" />
              <p class="mt-4 font-display text-[18px] leading-snug font-extrabold text-neutral-light 2xl:text-[20px]">
                {item.label}
              </p>
              <p class="mt-1 font-sans text-[15px] leading-relaxed text-neutral-light/75">
                {item.hint}
              </p>
            </li>
          ))}
        </ul>

        {/* Selo da equipe e CTA */}
        <div class="mt-7 flex flex-col gap-5 border-t border-[#1b5285] pt-5 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-center gap-5">
            <Icon name="shield-check" class="size-11 shrink-0 text-brand-yellow" />
            <span aria-hidden="true" class="h-11 w-px bg-white/20"></span>
            <span class="font-display text-[17px] font-bold text-neutral-light sm:text-[18px]">
              {supportPanel.microcopy}
            </span>
          </div>
          <button
            type="button"
            data-cta="identificar-cta"
            class="btn-slave-whats inline-flex shrink-0 items-center justify-center gap-3 rounded-xl bg-brand-yellow px-8 py-3.5 font-sans text-[18px] font-bold text-primary-dark-900 shadow-[0_14px_30px_-16px_rgba(0,0,0,0.55)] transition-colors duration-200 hover:bg-brand-yellow-dark motion-reduce:transition-none"
          >
            {supportPanel.cta}
            <Icon name="arrow-right" class="size-5 shrink-0 [stroke-width:2.4]" />
          </button>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  /* Fundo do mockup: navy com um brilho azul no canto superior direito e na base. */
  .support-panel {
    background:
      radial-gradient(1000px 520px at 100% -10%, rgb(0 78 150 / 0.55) 0%, transparent 62%),
      radial-gradient(900px 320px at 55% 115%, rgb(0 80 150 / 0.6) 0%, transparent 70%),
      linear-gradient(160deg, #003770 0%, #012b59 45%, #002a5c 100%);
  }

  .support-card {
    transition: background-color 260ms ease;
  }

  .support-card:hover {
    background-color: rgb(255 255 255 / 0.06);
  }

  @media (prefers-reduced-motion: reduce) {
    .support-card {
      transition: none;
    }
  }
</style>
