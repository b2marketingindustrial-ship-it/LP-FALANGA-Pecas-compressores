---
/**
 * Vitrine de produtos — fase "oferta" da biblioteca B2.
 *
 * Duas formas, resolvidas pelo conteúdo e não por entrada de briefing:
 *
 *   sem grupos  → uma grade de 2 colunas no mobile e 4 no desktop;
 *   com grupos  → uma prateleira por grupo, com a logo (ou o nome) no cabeçalho,
 *                 em trilho horizontal no mobile e grade no desktop.
 *
 * As duas invariantes do conteúdo são verificadas aqui, no build, porque o
 * `contract` do manifesto não expressa condição entre itens: descrição é tudo ou
 * nada, e todo item de vitrine agrupada aponta para um grupo existente.
 *
 * VARIANTE LOCAL desta LP (mockup do cliente, 21/10/2026, docs/BRIEFING.md): a mesma
 * linguagem da LP de compressores de parafuso — cabeçalho à esquerda com o traço
 * amarelo e a área atendida, cards contornados com o número da prateleira e o palco
 * claro do produto, e faixa de CTA fechando a seção. O contrato da seção é o mesmo da
 * biblioteca — dados, CTAs `vitrine-{item.id}`, `tone`/`rhythm` — mais o CTA
 * `vitrine-cotacao` da faixa final.
 *
 * ATENÇÃO: `npm run compose` recopia o componente da biblioteca e desfaz esta variante.
 * Recompor a página exige reaplicá-la a partir do git.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import Icon from '@components/Icon.astro'
import type { SectionProps } from '@lib/layout'
import { showcase, type ShowcaseGroup, type ShowcaseItem } from '@data/sections/vitrine'

type Props = SectionProps

const { tone, rhythm } = Astro.props
// Tipos largos de propósito: o `as const` dos dados deixa `groups: []` como `readonly []`
// e os ids como literais, e as verificações abaixo virariam `never` na vitrine sem grupos.
const { groups, items }: { groups: readonly ShowcaseGroup[]; items: readonly ShowcaseItem[] } =
  showcase

const described = items.filter((item) => item.description.trim()).length
if (described !== 0 && described !== items.length) {
  throw new Error(
    `vitrine: descrição é tudo ou nada — ${described} de ${items.length} itens têm a frase. ` +
      'Complete os que faltam ou apague todas: meia lista descrita lê como página inacabada.',
  )
}
const showText = described === items.length

const groupIds = new Set(groups.map((group) => group.id))
for (const item of items) {
  // Com grupos, item sem grupo não cai em prateleira nenhuma e sumiria da página em silêncio.
  if ((groups.length || item.group) && !groupIds.has(item.group)) {
    throw new Error(
      item.group
        ? `vitrine: o item "${item.id}" aponta para o grupo "${item.group}", que não existe em groups.`
        : `vitrine: o item "${item.id}" está sem grupo — com groups preenchido, todo item aponta para um deles.`,
    )
  }
}

/** Com grupos, uma prateleira por grupo; sem grupos, uma só, em grade. */
const railed = groups.length > 0
const shelves = railed
  ? groups.map((group) => ({
      group,
      items: items.filter((item) => item.group === group.id),
    }))
  : [{ group: null, items: [...items] }]

for (const shelf of shelves) {
  if (!shelf.items.length) {
    throw new Error(
      `vitrine: o grupo "${shelf.group?.id}" está sem itens. Remova o grupo ou aponte itens para ele.`,
    )
  }
}
---

<Section id="vitrine" tone={tone} rhythm={rhythm}>
  {/* Cabeçalho do mockup: traço amarelo, título navy grande e a área atendida */}
  <div class="max-w-3xl">
    <p class="flex items-center gap-4 font-sans text-[13px] font-bold tracking-[0.14em] text-brand-blue uppercase sm:text-[14px]">
      <span aria-hidden="true" class="h-[3px] w-10 shrink-0 rounded-full bg-brand-yellow"></span>
      {showcase.eyebrow}
    </p>
    <h2 class="mt-4 font-display text-[2.25rem] leading-[1.06] font-extrabold tracking-[-0.03em] text-primary-dark sm:text-[2.75rem] lg:text-[3rem] xl:text-[3.4rem]">
      {showcase.title}
    </h2>
    <p class="mt-5 max-w-2xl font-sans text-lg leading-relaxed text-ink-soft xl:text-xl">
      {showcase.text}
    </p>
    <p class="mt-5 flex items-center gap-2.5 font-sans text-[16px] font-medium text-ink">
      <Icon name="map-pin" class="size-5 shrink-0 text-brand-blue" />
      {showcase.area}
    </p>
  </div>

  <div class="mt-10 flex flex-col gap-10">
    {shelves.map((shelf) => (
      <div data-showcase-shelf>
        {/* Sem numeração: as prateleiras são famílias de produto, não uma sequência. */}
        {shelf.group && (
          <div class="flex items-baseline gap-4 border-b border-[#e3e8f1] pb-3">
            <h3 class="flex min-w-0 items-center">
              {shelf.group.logo ? (
                <Image
                  src={shelf.group.logo.src}
                  alt={shelf.group.logo.alt}
                  format="webp"
                  width={220}
                  loading="lazy"
                  decoding="async"
                  class="h-8 w-auto max-w-[120px] object-contain"
                />
              ) : (
                <span class="font-display text-[20px] leading-snug font-extrabold tracking-[-0.015em] text-brand-blue sm:text-[22px]">
                  {shelf.group.label}
                </span>
              )}
            </h3>
            <span class="ml-auto shrink-0 font-sans text-[14px] text-ink-soft">
              {shelf.items.length} itens
            </span>
          </div>
        )}

        <ul
          data-showcase-rail
          class:list={[
            // 5 colunas, e não 4: as prateleiras têm 9 e 10 itens, que em 4 colunas
            // quebram em 4+4+1 e 4+4+2 e deixam cinco buracos no fim das linhas.
            // Em 5 viram 5+4 e 5+5 — uma sobra só na página inteira.
            'mt-5 gap-4 lg:gap-5',
            railed
              ? 'scroll-track -mx-6 flex snap-x snap-mandatory overflow-x-auto px-6 pb-3 lg:mx-0 lg:grid lg:grid-cols-5 lg:overflow-visible lg:px-0 lg:pb-0'
              : 'grid grid-cols-2 lg:grid-cols-5',
          ]}
        >
          {shelf.items.map((item) => (
            <li class:list={[railed && 'w-[78%] shrink-0 snap-start sm:w-[44%] lg:w-auto']}>
              <button
                type="button"
                data-cta={`vitrine-${item.id}`}
                class="btn-slave-whats showcase-card group relative flex h-full w-full flex-col overflow-hidden rounded-2xl border border-[#e3e8f1] bg-neutral-light text-left shadow-[0_10px_30px_-24px_rgba(0,33,71,0.35)] transition-[transform,box-shadow,border-color] duration-300 ease-out hover:-translate-y-1.5 hover:border-brand-blue/30 hover:shadow-[0_28px_56px_-28px_rgba(0,33,71,0.4)] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
              >
                <span
                  aria-hidden="true"
                  class="absolute inset-x-0 top-0 z-10 h-[3px] origin-left scale-x-0 bg-brand-yellow transition-transform duration-300 ease-out group-hover:scale-x-100"
                />

                {/* Palco: o produto é o protagonista do card, por isso ocupa quase todo
                    o quadro e o fundo é só luz. `aspect` em vez de altura fixa para a
                    foto crescer junto com a coluna. */}
                <span class="showcase-card__stage relative flex aspect-[4/3] items-center justify-center overflow-hidden">
                  <Image
                    src={item.photo.src}
                    alt={item.photo.alt}
                    format="webp"
                    width={420}
                    loading="lazy"
                    decoding="async"
                    class="relative z-[1] max-h-[80%] w-auto max-w-[84%] object-contain mix-blend-multiply transition-transform duration-500 ease-out group-hover:scale-[1.06] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                </span>

                <span class="flex flex-1 items-start justify-between gap-2.5 border-t border-[#eef1f7] px-4 pt-3.5 pb-4">
                  <span class="flex min-w-0 flex-col gap-1.5">
                    {/* Altura mínima de duas linhas: sem ela, os títulos de uma linha e
                        de duas desalinham a base dos cards vizinhos. */}
                    <span class="min-h-[2.5em] font-display text-[15px] leading-[1.25] font-extrabold text-brand-blue">
                      {item.title}
                    </span>
                    {showText && (
                      <span class="font-sans text-[13px] leading-relaxed text-ink-soft">
                        {item.description}
                      </span>
                    )}
                  </span>
                  {/* Seta discreta: com uma bolinha amarela por card eram 19 na seção,
                      competindo com as fotos. O amarelo fica para os CTAs de verdade. */}
                  <Icon
                    name="arrow-right"
                    class="mt-0.5 size-4 shrink-0 text-brand-blue/35 transition-[color,transform] duration-300 [stroke-width:2.4] group-hover:translate-x-0.5 group-hover:text-brand-blue motion-reduce:transition-none"
                  />
                </span>
              </button>
            </li>
          ))}
        </ul>

        {railed && shelf.items.length > 1 && (
          <div class="mt-3 flex items-center justify-center gap-3 lg:hidden">
            <button
              type="button"
              data-rail-prev
              aria-label={`Produto anterior de ${shelf.group?.label}`}
              class="flex size-10 items-center justify-center rounded-full border border-[#e3e8f1] bg-neutral-light text-brand-blue transition-colors hover:border-brand-blue/40 hover:bg-brand-mist motion-reduce:transition-none"
            >
              <Icon name="chevron-right" class="size-4 rotate-180" />
            </button>
            <button
              type="button"
              data-rail-next
              aria-label={`Próximo produto de ${shelf.group?.label}`}
              class="flex size-10 items-center justify-center rounded-full border border-[#e3e8f1] bg-neutral-light text-brand-blue transition-colors hover:border-brand-blue/40 hover:bg-brand-mist motion-reduce:transition-none"
            >
              <Icon name="chevron-right" class="size-4" />
            </button>
          </div>
        )}
      </div>
    ))}
  </div>

  {/* Faixa de CTA */}
  <div class="mt-10 flex flex-col gap-5 rounded-2xl bg-brand-mist px-6 py-6 sm:flex-row sm:items-center sm:justify-between sm:px-10">
    <div class="flex items-center gap-5">
      <span aria-hidden="true" class="h-12 w-1 shrink-0 rounded-full bg-brand-yellow"></span>
      <div>
        <p class="font-display text-[20px] leading-snug font-extrabold text-brand-blue sm:text-[22px]">
          {showcase.closing.title}
        </p>
        <p class="mt-1 font-sans text-[15px] text-ink-soft sm:text-[16px]">
          {showcase.closing.text}
        </p>
      </div>
    </div>
    <button
      type="button"
      data-cta="vitrine-cotacao"
      class="btn-slave-whats inline-flex shrink-0 items-center justify-center gap-3 rounded-xl bg-brand-blue px-8 py-4 font-sans text-[17px] font-bold text-neutral-light shadow-[0_14px_30px_-16px_rgba(0,67,161,0.7)] transition-colors duration-200 hover:bg-brand-blue-dark motion-reduce:transition-none"
    >
      <Icon name="whatsapp" class="size-6 shrink-0" />
      {showcase.closing.cta}
    </button>
  </div>
</Section>

<style>
  /* Palco do produto: luz vinda de cima, como numa foto de catálogo, e nada mais.
     A malha de pontos que havia aqui disputava atenção com a peça — e, atrás dos
     filtros brancos, lia como sujeira na foto. O `mix-blend-multiply` da imagem
     come o fundo branco das fotos, então recorte e fundo branco convivem no grid. */
  .showcase-card__stage {
    background:
      radial-gradient(118% 88% at 50% 16%, #ffffff 0%, rgb(255 255 255 / 0) 68%),
      linear-gradient(180deg, #f3f6fb 0%, #eaeff7 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-card,
    .showcase-card * {
      transition: none !important;
    }

    .showcase-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  document.querySelectorAll<HTMLElement>('[data-showcase-shelf]').forEach((shelf) => {
    const rail = shelf.querySelector<HTMLElement>('[data-showcase-rail]')
    const prev = shelf.querySelector<HTMLButtonElement>('[data-rail-prev]')
    const next = shelf.querySelector<HTMLButtonElement>('[data-rail-next]')
    if (!rail || !prev || !next) return

    const step = () => {
      const card = rail.querySelector<HTMLElement>('li')
      return card ? card.offsetWidth + 16 : rail.clientWidth * 0.8
    }
    const go = (dir: number) =>
      rail.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' })

    prev.addEventListener('click', () => go(-1))
    next.addEventListener('click', () => go(1))
  })
</script>
